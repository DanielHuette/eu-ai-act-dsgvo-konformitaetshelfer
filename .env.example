# Vorlage für die Umgebungsvariablen des Konformitätshelfers.
#
# So verwenden:   cp .env.example .env   und dann .env ausfüllen.
# .env steht in .gitignore und in .dockerignore — hier gehört NIE ein echter
# Schlüssel hinein, auch nicht "nur zum Ausprobieren". Diese Datei liegt im
# Quellbestand und wird mitveröffentlicht.
#
# Jede Zeile hat eine Erklärung darüber. Ohne .env läuft der Dienst auch:
# dann gelten die Vorgaben, die hier jeweils genannt sind.


# --------------------------------------------------------------- Netzzugang

# Auf welcher Adresse der Dienst lauscht.
# 127.0.0.1 heißt: nur dieser Rechner. 0.0.0.0 heißt: jedes Netz, an dem der
# Rechner hängt — im Container richtig, auf dem eigenen Rechner meist nicht.
# Vorgabe auf dem Rechner: 127.0.0.1 · im Container: 0.0.0.0
HELFER_ADRESSE=127.0.0.1

# Der Zugang, auf dem der Dienst antwortet. Vorgabe: 8000
HELFER_PORT=8000

# Von welchen Adressen aus eine Webseite die Schnittstelle aufrufen darf
# (mehrere mit Komma trennen). Ein Sternchen gibt es hier nicht: eine fremde
# Seite soll nicht im Namen des Nutzers Rechtsfragen stellen können.
# Vorgabe: http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173
HELFER_HERKUNFT=http://localhost:8000,http://127.0.0.1:8000

# Wie viele Anfragen eine Adresse je Minute stellen darf. Schützt vor
# Überlast. Gilt nur für die Wege unter /api/, nicht für Oberfläche und
# Zustandsbericht. Vorgabe: 30
HELFER_ANFRAGEN_JE_MINUTE=30


# ------------------------------------------------------------- Suchmodell

# Mit welchem Modell Texte in Zahlenreihen verwandelt werden.
# Wichtig: Dieser Wert gilt NUR, wenn der Suchbestand im Speicher gebaut
# werden muss. Liegt der Bestand als Datei vor, steht das Modell in der Datei
# und wird von dort genommen — Zahlenreihen verschiedener Modelle sind nicht
# vergleichbar, darum darf das nicht auseinanderlaufen.
#   BAAI/bge-m3            das gute Modell, rund 2,3 Gigabyte, mehrsprachig
#   streuwerk-ersatz       Ersatz ohne Modell: vergleicht nur Wörter, keine
#                          Bedeutung. Läuft sofort, findet deutlich schlechter.
# Vorgabe, wenn hier nichts steht: streuwerk-ersatz — damit kein Start
# ungefragt 2,3 Gigabyte aus dem Netz holt.
HELFER_EINBETTUNG=BAAI/bge-m3

# Ob der Kreuzbewerter die gefundenen Stellen neu sortieren darf.
# Er liest Frage und Fundstelle zusammen und sortiert dadurch messbar besser —
# rechnet aber 30 Textpaare durch ein großes Modell. Ohne Grafikkarte dauert
# eine Suche damit etwa 100 Sekunden; mit Grafikkarte unter einer Sekunde.
# 1 = ein · 0 = aus. Vorgabe: 0
HELFER_NEUBEWERTUNG=0


# --------------------------------------------------- Formulierung der Antwort
#
# Die Einstufung entsteht IMMER ohne Sprachmodell, aus den Regeldateien. Ein
# Sprachmodell formuliert nur den Text drumherum und kann das Ergebnis nicht
# ändern. Ohne Sprachmodell ist die Auskunft knapper, inhaltlich dieselbe.

# Welcher Antwortgeber formulieren soll:
#   auto        nehmen, was erreichbar ist: Claude, dann GPT, dann Ollama
#   anthropic   Claude
#   openai      GPT
#   ollama      ein Modell auf demselben Rechner
#   ohne        kein Sprachmodell, Antwort allein aus dem Regelwerk
# Vorgabe: auto
HELFER_MODELL=auto

# Zugangsschlüssel. HIER NICHTS EINTRAGEN, WAS ECHT IST.
# Eintragen in der eigenen .env, die niemand sonst sieht. Wer keinen Schlüssel
# hat, lässt die Zeilen leer und setzt HELFER_MODELL=ollama oder =ohne.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Wo Ollama läuft, falls es genutzt wird. Im Container, der mit dem Profil
# "ollama" gestartet wurde: http://ollama:11434
# Vorgabe: http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434

# Welches Modell Ollama nehmen soll. Vorgabe: qwen2.5:7b-instruct
OLLAMA_MODELL=qwen2.5:7b-instruct


# ------------------------------------------------------------------ Ablagen

# Wo heruntergeladene Modelle liegen. Im Container /opt/modelle, dort liegt
# das Einbettungsmodell bereits im Abbild.
# Vorgabe auf dem Rechner: ~/.cache/huggingface
HF_HOME=

# Verbietet dem Modellpaket, ins Netz zu greifen. Im Container auf 1, damit
# ein fehlendes Modell sofort auffällt statt still nachzuladen.
HF_HUB_OFFLINE=0


# ----------------------------------------------------------- Fehlersuche
#
# NICHT im Betrieb setzen. Der Dienst warnt beim Start, wenn eine dieser
# Variablen gesetzt ist: im Fehlersuchbetrieb können Innereien nach außen
# gelangen, die niemand sehen soll.
# DEBUG=

# Ob der Dienst den Suchbestand beim Start selbst bauen darf, wenn die
# abgelegten Dateien fehlen. Mit dem guten Modell dauert das auf einem
# Rechner ohne Grafikkarte Stunden — darum ist es aus, und der Dienst nimmt
# dann das Ersatzmodell und sagt das. Richtig ist, den Bestand einmal zu
# bauen:  python -m scripts.bestand_bauen
# 1 = erlauben und warten · 0 = nicht bauen. Vorgabe: 0
HELFER_BESTAND_BAUEN=0
