# Einheitliche Einrückung und Zeilenenden über alle Werkzeuge hinweg.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Zeilenlänge wie in pyproject.toml bei ruff festgelegt
[*.py]
max_line_length = 100

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

# YAML verträgt keine Tabulatoren und wird zwei Zeichen tief eingerückt
[*.{yaml,yml}]
indent_size = 2

[*.{json,jsonl}]
indent_size = 2

[*.cff]
indent_size = 2

[*.toml]
indent_size = 4

[*.xml]
indent_size = 4

# In Markdown bedeuten zwei Leerzeichen am Zeilenende einen Zeilenumbruch.
# Sie dürfen deshalb nicht weggeschnitten werden.
[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{gradle,properties}]
indent_size = 4

# Vom Bauwerkzeug erzeugt — nicht von Hand ändern
[gradlew*]
indent_style = unset
indent_size = unset

[Makefile]
indent_style = tab

[Dockerfile]
indent_size = 4

[*.sh]
indent_size = 2

# PowerShell läuft auf Windows; dort sind CRLF üblich
[*.ps1]
end_of_line = crlf
indent_size = 4
