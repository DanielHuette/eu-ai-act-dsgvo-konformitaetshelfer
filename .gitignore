# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Schlüssel und örtliche Einstellungen. Ein Schlüssel in einer Datei ist ein
# Schlüssel, der einmal versehentlich mitwandert.
.env
.env.*
!.env.example
*.key
*.pem
schluessel.txt

# Rohquellen aus dem Netz. Sie werden mit scripts/holen_*.py geholt und sind
# zusammen über 7 MB groß; der daraus gebaute Korpus liegt dagegen mit im
# Verzeichnis, damit das Werkzeug ohne Beschaffungslauf startklar ist.
daten/roh/

# Der Suchbestand für den Rechner WIRD MITGELIEFERT — er ist der Grund, dass
# das Werkzeug nach dem Klonen sofort gut sucht statt erst nach einer Stunde
# Rechenzeit. 13 MB: die Vektoren als .npy, der Rest als gepacktes JSON.
#
# Dass die Einbettungen verschiedener Modelle nicht vergleichbar sind, spricht
# nicht dagegen: der Bestand trägt den Modellnamen, und wer ihn mit einem
# anderen Modell lädt, bekommt einen Abbruch mit Begründung statt stiller
# Fehltreffer. Wer ein anderes Modell will, baut neu — scripts/bestand_bauen.py.
#
# Die Teilstücke des laufenden Baus gehören dagegen nicht hinein: sie sind
# Baustelle, nicht Ergebnis.
daten/aufbereitet/_bestand_teile/
daten/aufbereitet/_bestand_lauf.log

# Die eingebetteten Zwecksaetze. Werden beim ersten Gebrauch gerechnet und
# traegen die Anzahl der Saetze mit; aendert sich der Zweckkatalog, rechnet der
# Helfer sie neu. Ein mitgelieferter Zwischenstand koennte nicht mehr passen.
daten/regeln/_zwecke_vektoren.json.gz

# Die Beigaben der Android-App: Rechtsdatenbank (10,7 MB), umgewandelter
# Einbetter (118 MB) und Wortschatz (17 MB), zusammen rund 146 MB. GitHub
# nimmt keine Datei ueber 100 MB, und abgelegt waeren sie ein zweites Mal
# dasselbe: sie entstehen vollstaendig aus korpus.jsonl, den Regeldateien und
# den Faellen. Neu bauen mit
#     python scripts/export_android.py
# Der Lauf prueft sich selbst und schreibt keine halbfertige Datenbank; der
# Befund steht in daten/aufbereitet/android_export_befund.json und ist
# abgelegt, damit der Stand der App auch ohne die Dateien nachlesbar ist.
android/app/src/main/assets/

# Modellspeicher, falls jemand ihn ins Verzeichnis legt
modelle/
*.safetensors
*.bin

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.cxx/
*.apk
*.aab
*.jks
*.keystore
ausgabe/

# Werkzeuge der Entwicklungsumgebung
.idea/
.vscode/
*.iml

# Betriebssystem
.DS_Store
Thumbs.db
desktop.ini

# Zwischenstände von Hand
*.bak
*.orig
*.tmp
~$*
