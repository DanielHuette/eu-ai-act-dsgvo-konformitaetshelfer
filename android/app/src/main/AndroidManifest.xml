<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Die einzige Berechtigung der App, und sie ist nur für einen Fall da:
      wer selbst einen Schlüssel für Claude oder GPT einträgt, will eine
      ausformulierte Auskunft, und dafür muss die Frage an den Anbieter
      gehen. Ohne eingetragenen Schlüssel geht nichts ins Netz - Einstufung,
      Suche und Pflichtenliste rechnen auf dem Gerät.

      Was hier bewusst NICHT steht: Standort, Kontakte, Kamera, Mikrofon,
      Speicherzugriff, Telefonstatus. Wer sein KI-System beschreibt, verrät
      Geschäftsinterna; eine App, die dabei den Standort mitnimmt, hat ihr
      Versprechen schon gebrochen.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Riegel gegen eingeschleppte Berechtigungen.

      Eine Abhängigkeit kann im eigenen Manifest Berechtigungen anmelden, und
      die landen beim Zusammenführen im fertigen Paket, ohne dass hier eine
      Zeile dazu stünde. Genau das war der Fall: die ONNX-Laufzeit meldet ab
      Fassung 1.29.0 ACCESS_NETWORK_STATE an und startet einen
      ContentProvider für Telemetrie. Die Fassung ist deshalb auf 1.28.0
      festgelegt (siehe gradle/libs.versions.toml).

      Die beiden Zeilen hier sind der zweite Riegel: wer die Fassung später
      erhöht, bekommt die Telemetrie nicht stillschweigend mit zurück. Jede
      Zeile nennt, was sie fernhält.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_PHONE_STATE"
        tools:node="remove" />

    <application
        android:name=".Anwendung"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/datenregeln"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Konformitaetshelfer"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/netzregeln"
        android:localeConfig="@xml/sprachen"
        android:largeHeap="true">
        <!--
          largeHeap: der Wortschatz des Einbetters hat 250 002 Einträge und
          liegt beim Zerlegen einer Frage im Speicher. Auf einem Gerät mit
          kleinem Standardspeicher reicht der Vorrat sonst nicht.

          allowBackup und dataExtractionRules: nichts wird gesichert oder auf
          ein anderes Gerät übertragen. In den Einstellungen liegt ein
          Anbieterschlüssel; der gehört nicht in eine Sicherung.
        -->

        <!-- Kein Telemetrie-Anlasser, auch nicht aus einer Abhängigkeit. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
