<?xml version="1.0" encoding="utf-8"?>
<!-- Keine Sicherung, keine Geräteübertragung. Der Anbieterschlüssel bleibt
     auf diesem Gerät, sonst wäre der verschlüsselte Speicher umsonst. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
