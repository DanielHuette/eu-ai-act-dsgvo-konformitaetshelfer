<?xml version="1.0" encoding="utf-8"?>
<!--
  Klartext ist überall verboten. Die App spricht nur mit zwei Gegenstellen,
  und beide können HTTPS. Ein Rückfall auf HTTP würde die Systembeschreibung
  des Nutzers im Klartext über das Netz schicken.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
